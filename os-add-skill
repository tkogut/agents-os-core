#!/usr/bin/env python3
import os
import sys
import json
import re
import urllib.request
import urllib.error

# Konfiguracja źródeł zdalnych
TKOGUT_API_URL = "https://api.github.com/repos/tkogut/agents-os-core/contents/global_skills/{skill_name}"
SICKN33_API_URL = "https://api.github.com/repos/sickn33/antigravity-awesome-skills/contents/skills/{skill_name}"

HEADERS = {"User-Agent": "Antigravity-Agent-Swarm"}

def find_project_root():
    curr = os.getcwd()
    while curr != os.path.dirname(curr):
        if os.path.exists(os.path.join(curr, ".agents")):
            return curr
        curr = os.path.dirname(curr)
    return None

def download_item(url, dest_path):
    print(f"   📥 Pobieranie: {os.path.basename(dest_path)}...")
    os.makedirs(os.path.dirname(dest_path), exist_ok=True)
    req = urllib.request.Request(url, headers=HEADERS)
    try:
        with urllib.request.urlopen(req) as response, open(dest_path, "wb") as out_file:
            out_file.write(response.read())
    except Exception as e:
        print(f"   ❌ Nie udało się pobrać {url}: {e}")

def fetch_dir(skill_name, api_url, dest_dir, prefix_to_strip, skill_root_dir=None):
    if skill_root_dir is None:
        skill_root_dir = dest_dir
    req = urllib.request.Request(api_url, headers=HEADERS)
    try:
        with urllib.request.urlopen(req) as response:
            items = json.loads(response.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return False
        else:
            print(f"❌ Błąd API GitHub ({e.code}): {e.reason}")
            return False
    except Exception as e:
        print(f"❌ Błąd połączenia z API GitHub: {e}")
        return False

    if not isinstance(items, list):
        print(f"❌ Niepoprawny format odpowiedzi z API.")
        return False

    for item in items:
        name = item.get("name")
        item_type = item.get("type")
        download_url = item.get("download_url")
        path = item.get("path")
        
        # Obcinanie relatywnego prefiksu w zależności od repozytorium
        if path.startswith(prefix_to_strip):
            rel_path = path[len(prefix_to_strip):]
        else:
            rel_path = name
        
        target_path = os.path.abspath(os.path.join(skill_root_dir, rel_path))
        
        # Ochrona przed Path Traversal
        if not target_path.startswith(os.path.abspath(skill_root_dir)):
            print(f"   ⚠️ Zablokowano próbę zapisu poza katalog docelowy: {target_path}")
            continue

        if item_type == "file" and download_url:
            download_item(download_url, target_path)
        elif item_type == "dir":
            # Rekurencyjne pobranie podkatalogu
            fetch_dir(skill_name, item.get("url"), target_path, prefix_to_strip, skill_root_dir)
            
    return True

def main():
    if len(sys.argv) < 2:
        print("Użycie: os-add-skill <nazwa-skilla>")
        sys.exit(1)

    skill_name = sys.argv[1]
    
    # Rygorystyczna walidacja nazwy skilla (tylko znaki alfanumeryczne, myślniki, podkreślenia)
    if not re.match(r"^[a-zA-Z0-9\-_]+$", skill_name):
        print("❌ BŁĄD: Nazwa skilla może zawierać tylko litery, cyfry, myślniki i podkreślenia.")
        sys.exit(1)

    project_root = find_project_root()
    if not project_root:
        print("❌ BŁĄD: Nie jesteś w katalogu projektu AGENTS-OS (brak folderu .agents/).")
        sys.exit(1)

    dest_dir = os.path.abspath(os.path.join(project_root, ".agents", "skills", skill_name))

    # ==========================================================================
    # ŹRÓDŁO 1: LOKALNY SZABLON (Najwyższy priorytet - offline, natychmiast)
    # ==========================================================================
    local_template_path = os.path.expanduser(f"~/.antigravity/templates/v6.0-swarm/.agents/skills/{skill_name}")
    if os.path.exists(local_template_path):
        print(f"🪐 [1/3] Pobieranie skilla '{skill_name}' z lokalnego szablonu (v6.0-swarm)...")
        import shutil
        try:
            if os.path.exists(dest_dir):
                shutil.rmtree(dest_dir)
            shutil.copytree(local_template_path, dest_dir)
            print(f"✅ Skill '{skill_name}' zainstalowany lokalnie.")
            sys.exit(0)
        except Exception as e:
            print(f"⚠️ Błąd kopiowania lokalnego (próbuję pobrać z sieci): {e}")

    # ==========================================================================
    # ŹRÓDŁO 2: TWÓJ GITHUB (tkogut/agents-os-core)
    # ==========================================================================
    print(f"🪐 [2/3] Szukam skilla '{skill_name}' w repozytorium tkogut/agents-os-core...")
    # W tkogut/agents-os-core skille są w global_skills/<nazwa-skilla>, stąd prefiks:
    prefix_tkogut = f"global_skills/{skill_name}/"
    success_tkogut = fetch_dir(
        skill_name, 
        TKOGUT_API_URL.format(skill_name=skill_name), 
        dest_dir, 
        prefix_to_strip=prefix_tkogut
    )
    
    if success_tkogut:
        print(f"✅ Skill '{skill_name}' pobrany pomyślnie z repozytorium tkogut/agents-os-core.")
        sys.exit(0)

    # ==========================================================================
    # ŹRÓDŁO 3: OFICJALNY GITHUB (sickn33/antigravity-awesome-skills)
    # ==========================================================================
    print(f"🪐 [3/3] Szukam skilla '{skill_name}' w rejestrze sickn33/antigravity-awesome-skills...")
    # W awesome-skills skille są w skills/<nazwa-skilla>, stąd prefiks:
    prefix_sickn33 = f"skills/{skill_name}/"
    success_sickn33 = fetch_dir(
        skill_name, 
        SICKN33_API_URL.format(skill_name=skill_name), 
        dest_dir, 
        prefix_to_strip=prefix_sickn33
    )

    if success_sickn33:
        print(f"✅ Skill '{skill_name}' pobrany pomyślnie z rejestru awesome-skills.")
        sys.exit(0)

    # Jeśli żadne źródło nie powiodło się
    print(f"❌ BŁĄD: Skill '{skill_name}' nie został znaleziony w żadnym z dostępnych źródeł.")
    sys.exit(1)

if __name__ == "__main__":
    main()
