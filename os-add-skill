#!/usr/bin/env python3
"""os-add-skill - instalator skilli AGENTS-OS.

Bezpieczenstwo dostaw (ISO 27001, A.8.30 / A.5.23):
  * kazde zrodlo zdalne ma PRZYPIETY ref (commit SHA / tag) - nie HEAD galezi,
  * kazdy pobrany plik jest hashowany (SHA-256) i zapisywany w .skill-lock.json,
  * blad pobrania jest FATALNY (wczesniej byl polykany -> cichy czesciowy install),
  * --expect-sha256 weryfikuje zagregowany digest calego skilla (fail-closed),
  * --strict / AGENTS_OS_REQUIRE_PIN=1 odrzuca instalacje z nieprzypietego refa.
"""
import os
import sys
import json
import re
import shutil
import hashlib
import argparse
import urllib.request
import urllib.error

# --------------------------------------------------------------------------- #
# Konfiguracja zrodel zdalnych
#
# PINNED_REF: przypiety ref dla danego zrodla. None = brak pinu (HEAD galezi
# domyslnej) - dopuszczone dla wstecznej kompatybilnosci, ale glosno ostrzegane
# i blokowane w trybie --strict.
# --------------------------------------------------------------------------- #
SOURCES = [
    {
        "label": "tkogut/agents-os-core",
        "api": "https://api.github.com/repos/tkogut/agents-os-core/contents/global_skills/{skill_name}",
        "prefix": "global_skills/{skill_name}/",
        "pinned_ref": None,
    },
    {
        "label": "sickn33/antigravity-awesome-skills",
        "api": "https://api.github.com/repos/sickn33/antigravity-awesome-skills/contents/skills/{skill_name}",
        "prefix": "skills/{skill_name}/",
        "pinned_ref": None,
    },
]

HEADERS = {"User-Agent": "Antigravity-Agent-Swarm"}
LOCK_FILENAME = ".skill-lock.json"


def find_project_root():
    curr = os.getcwd()
    while curr != os.path.dirname(curr):
        if os.path.exists(os.path.join(curr, ".agents")):
            return curr
        curr = os.path.dirname(curr)
    return None


def with_ref(url, ref):
    if not ref:
        return url
    return url + ("&" if "?" in url else "?") + "ref=" + ref


def download_item(url, dest_path, digests, skill_root_dir):
    """Pobiera jeden plik. Blad => wyjatek (NIE polykamy go po cichu)."""
    print("   [get] %s" % os.path.basename(dest_path))
    os.makedirs(os.path.dirname(dest_path), exist_ok=True)
    req = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(req) as response:
        data = response.read()
    with open(dest_path, "wb") as out_file:
        out_file.write(data)
    rel = os.path.relpath(dest_path, skill_root_dir).replace(os.sep, "/")
    digests[rel] = hashlib.sha256(data).hexdigest()


def fetch_dir(api_url, dest_dir, prefix_to_strip, skill_root_dir, ref, digests):
    req = urllib.request.Request(with_ref(api_url, ref), headers=HEADERS)
    try:
        with urllib.request.urlopen(req) as response:
            items = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return False
        print("[ERR] Blad API GitHub (%s): %s" % (e.code, e.reason))
        return False
    except Exception as e:
        print("[ERR] Blad polaczenia z API GitHub: %s" % e)
        return False

    if not isinstance(items, list):
        print("[ERR] Niepoprawny format odpowiedzi z API.")
        return False

    for item in items:
        name = item.get("name")
        item_type = item.get("type")
        download_url = item.get("download_url")
        path = item.get("path")

        rel_path = path[len(prefix_to_strip):] if path.startswith(prefix_to_strip) else name
        target_path = os.path.abspath(os.path.join(skill_root_dir, rel_path))

        # Ochrona przed Path Traversal
        if not target_path.startswith(os.path.abspath(skill_root_dir) + os.sep) \
                and target_path != os.path.abspath(skill_root_dir):
            print("   [!] Zablokowano zapis poza katalog docelowy: %s" % target_path)
            continue

        if item_type == "file" and download_url:
            download_item(download_url, target_path, digests, skill_root_dir)
        elif item_type == "dir":
            fetch_dir(item.get("url"), target_path, prefix_to_strip, skill_root_dir, ref, digests)

    return True


def aggregate_digest(digests):
    """Deterministyczny digest calego skilla: sha256 po posortowanych parach."""
    h = hashlib.sha256()
    for rel in sorted(digests):
        h.update(rel.encode("utf-8"))
        h.update(b"\0")
        h.update(digests[rel].encode("ascii"))
        h.update(b"\n")
    return h.hexdigest()


def write_lock(dest_dir, source_label, ref, digests, agg):
    lock = {
        "skill": os.path.basename(dest_dir),
        "source": source_label,
        "ref": ref or "UNPINNED (default branch HEAD)",
        "pinned": bool(ref),
        "aggregate_sha256": agg,
        "files": {k: digests[k] for k in sorted(digests)},
    }
    with open(os.path.join(dest_dir, LOCK_FILENAME), "w", encoding="utf-8") as fh:
        json.dump(lock, fh, indent=2, ensure_ascii=False)
        fh.write("\n")


def compare_previous_lock(dest_dir):
    """Jesli skill byl juz zainstalowany - pokaz czy zawartosc sie zmienila."""
    prev_path = os.path.join(dest_dir, LOCK_FILENAME)
    if not os.path.exists(prev_path):
        return None
    try:
        with open(prev_path, encoding="utf-8") as fh:
            return json.load(fh).get("aggregate_sha256")
    except Exception:
        return None


def ensure_claude_symlink(project_root, skill_name):
    claude_skills = os.path.join(project_root, ".claude", "skills")
    os.makedirs(claude_skills, exist_ok=True)
    target_link = os.path.join(claude_skills, skill_name)
    src_rel = os.path.join("..", "..", ".agents", "skills", skill_name)
    try:
        if os.path.islink(target_link) or os.path.exists(target_link):
            os.remove(target_link)
        os.symlink(src_rel, target_link)
        print("   [link] .claude/skills/%s" % skill_name)
    except Exception:
        pass


def main():
    parser = argparse.ArgumentParser(prog="os-add-skill")
    parser.add_argument("skill_name")
    parser.add_argument("--ref", default=None,
                        help="Przypnij pobranie do commit SHA / tagu / galezi (nadpisuje pin zrodla).")
    parser.add_argument("--expect-sha256", default=None,
                        help="Oczekiwany zagregowany SHA-256 skilla. Niezgodnosc = przerwanie i rollback.")
    parser.add_argument("--strict", action="store_true",
                        default=os.environ.get("AGENTS_OS_REQUIRE_PIN") == "1",
                        help="Odmow instalacji z nieprzypietego refa (lub AGENTS_OS_REQUIRE_PIN=1).")
    args = parser.parse_args()

    skill_name = args.skill_name
    if not re.match(r"^[a-zA-Z0-9\-_]+$", skill_name):
        print("[ERR] Nazwa skilla moze zawierac tylko litery, cyfry, myslniki i podkreslenia.")
        sys.exit(1)

    project_root = find_project_root()
    if not project_root:
        print("[ERR] Nie jestes w katalogu projektu AGENTS-OS (brak folderu .agents/).")
        sys.exit(1)

    dest_dir = os.path.abspath(os.path.join(project_root, ".agents", "skills", skill_name))
    previous_agg = compare_previous_lock(dest_dir)

    # ---------------------------------------------------------------------- #
    # ZRODLO 1: lokalny szablon (offline, brak wektora supply-chain)
    # ---------------------------------------------------------------------- #
    local_template_path = os.path.expanduser(
        "~/.antigravity/templates/v6.5-swarm/.agents/skills/%s" % skill_name)
    if os.path.exists(local_template_path):
        print("[1/3] Skill '%s' z lokalnego szablonu (v6.5-swarm)..." % skill_name)
        try:
            if os.path.exists(dest_dir):
                shutil.rmtree(dest_dir)
            shutil.copytree(local_template_path, dest_dir)
            ensure_claude_symlink(project_root, skill_name)
            print("[OK] Skill '%s' zainstalowany lokalnie (bez pobrania z sieci)." % skill_name)
            sys.exit(0)
        except Exception as e:
            print("[!] Blad kopiowania lokalnego (probuje pobrac z sieci): %s" % e)

    # ---------------------------------------------------------------------- #
    # ZRODLA ZDALNE
    # ---------------------------------------------------------------------- #
    for idx, src in enumerate(SOURCES, start=2):
        ref = args.ref or src["pinned_ref"]
        if not ref:
            msg = ("[!] UWAGA: zrodlo %s nie jest przypiete do refa - pobieram HEAD "
                   "galezi domyslnej. Tresc moze zmienic sie miedzy instalacjami." % src["label"])
            if args.strict:
                print(msg)
                print("[ERR] Tryb --strict: instalacja z nieprzypietego refa odrzucona. "
                      "Podaj --ref <commit-sha>.")
                sys.exit(2)
            print(msg)

        print("[%d/3] Szukam '%s' w %s (ref=%s)..."
              % (idx, skill_name, src["label"], ref or "HEAD"))

        digests = {}
        staging = dest_dir + ".partial"
        if os.path.exists(staging):
            shutil.rmtree(staging)
        try:
            ok = fetch_dir(src["api"].format(skill_name=skill_name), staging,
                           src["prefix"].format(skill_name=skill_name), staging, ref, digests)
        except Exception as e:
            # Pobranie czesciowe NIE jest sukcesem.
            print("[ERR] Przerwano pobieranie (%s). Instalacja odrzucona, nic nie zmieniono." % e)
            shutil.rmtree(staging, ignore_errors=True)
            sys.exit(1)

        if not ok:
            shutil.rmtree(staging, ignore_errors=True)
            continue

        agg = aggregate_digest(digests)
        print("   [sha256] %s (%d plikow)" % (agg, len(digests)))

        if args.expect_sha256 and args.expect_sha256.lower() != agg:
            print("[ERR] NIEZGODNOSC INTEGRALNOSCI.")
            print("      oczekiwano: %s" % args.expect_sha256.lower())
            print("      otrzymano:  %s" % agg)
            shutil.rmtree(staging, ignore_errors=True)
            sys.exit(3)

        if previous_agg and previous_agg != agg:
            print("   [!] Tresc skilla ZMIENILA SIE wzgledem poprzedniej instalacji.")
            print("       poprzednio: %s" % previous_agg)
            print("       teraz:      %s" % agg)

        if os.path.exists(dest_dir):
            shutil.rmtree(dest_dir)
        shutil.move(staging, dest_dir)
        write_lock(dest_dir, src["label"], ref, digests, agg)
        ensure_claude_symlink(project_root, skill_name)
        print("[OK] Skill '%s' pobrany z %s. Lock: .agents/skills/%s/%s"
              % (skill_name, src["label"], skill_name, LOCK_FILENAME))
        sys.exit(0)

    print("[ERR] Skill '%s' nie zostal znaleziony w zadnym ze zrodel." % skill_name)
    sys.exit(1)


if __name__ == "__main__":
    main()
