#!/bin/bash
# Swarm Triad Role Enforcement pre-commit hook
# Version: 6.5-swarm
# Install: cp vault/.git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

ROLE=${SWARM_ROLE:-"coordinator"}

# Files that coordinator CAN modify (docs, specs, plans)
COORDINATOR_ALLOW="\.md$|\.txt$|\.json$|agents\.md|CHANGELOG|README|SDLC|specs/"

# Files that auditor CAN modify (reports, logs)
AUDITOR_ALLOW="handshake\.json$|audit|report|\.log$"

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged_files" ]; then
    exit 0
fi

violations=0

case "$ROLE" in
    coordinator)
        while IFS= read -r file; do
            if ! echo "$file" | grep -qE "$COORDINATOR_ALLOW"; then
                echo "ERR: Role 'coordinator' (Coordinator/GEM) is forbidden from directly committing functional changes to '$file'!"
                echo "Staged file violation: $file"
                ((violations++))
            fi
        done <<< "$staged_files"
        ;;
    auditor)
        while IFS= read -r file; do
            if ! echo "$file" | grep -qE "$AUDITOR_ALLOW"; then
                echo "ERR: Role 'auditor' is forbidden from modifying '$file'!"
                echo "Staged file violation: $file"
                ((violations++))
            fi
        done <<< "$staged_files"
        ;;
    builder)
        # Builder can modify anything
        ;;
    *)
        echo "WARN: Unknown SWARM_ROLE='$ROLE'. Defaulting to coordinator restrictions."
        ;;
esac

if [ $violations -gt 0 ]; then
    echo "ERR: Commit aborted. Under Swarm Triad rules, functional modifications must be implemented by the Builder role."
    exit 1
fi

exit 0
